{
  "version": "1.4",
  "build": "408-HOME-2.5",
  "contract": "home-review-journey-v1",
  "route": "/home/",
  "stages": ["landing", "engagement", "personalized_payoff", "lead_capture", "confirmation", "coveragefit_handoff", "assessment", "completion"],
  "events": [
    "home_journey_viewed",
    "home_primary_cta_selected",
    "home_engagement_started",
    "home_engagement_step_viewed",
    "home_engagement_step_completed",
    "home_engagement_completed",
    "home_personalized_payoff_viewed",
    "home_personalized_payoff_continued",
    "home_personalized_payoff_edit_selected",
    "home_lead_capture_presented",
    "home_lead_capture_step_viewed",
    "home_lead_capture_step_completed",
    "home_lead_capture_back_selected",
    "home_lead_form_started",
    "home_lead_submission_attempted",
    "home_lead_submission_confirmed",
    "home_lead_submission_pending",
    "home_lead_submission_unconfirmed",
    "home_confirmation_viewed",
    "home_confirmation_continued",
    "home_coveragefit_launched",
    "home_assessment_started",
    "home_assessment_completed"
  ],
  "semanticFields": {
    "home_review_goal": ["farmers_fit", "coverage_fit", "home_auto_bundle", "exploring"],
    "housing_context": ["owner_occupied", "landlord", "buyer", "renter"],
    "review_timing": ["shopping_now", "renewal_60", "later", "not_sure"]
  },
  "leadCapture": {
    "stepCount": 2,
    "step1": ["first_name", "last_name", "phone", "email"],
    "step2": ["property_address", "consent"],
    "derived": ["review_context"],
    "noJavaScriptFallback": "complete-form",
    "renterPropertyAddressRequired": false
  },
  "confirmation": {
    "statuses": ["confirmed", "pending", "unconfirmed", "local-fallback"],
    "automaticContinuation": true,
    "manualContinueAvailable": true,
    "delayMilliseconds": 1250,
    "homeownerNext": "CoverageFit property confirmation then existing Home assessment",
    "renterNext": "/contact/?intent=renters"
  },
  "privacy": {
    "eventData": "Only allowlisted journey, campaign, route, status, step, bounded semantic fields, destination type, and continuation trigger.",
    "excluded": ["name", "email", "phone", "property address", "free-form answers"],
    "visibleUrl": "The existing CoverageFit prefill scrub remains required."
  },
  "leadPoints": ["408FARMERS lead submission", "CoverageFit completed assessment submission"],
  "scope": {
    "userVisibleJourneyChanged": true,
    "assessmentQuestionsChanged": false,
    "protectionScoreChanged": false,
    "buyerChanged": false,
    "occupationalFlowsChanged": false,
    "lifeChanged": false,
    "rcSmsChanged": false
  }
}
